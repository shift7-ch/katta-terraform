# GitHub Personal Access Token not required for public repositories
#github_token=

# DNS suffix for service endpoints
#dns_suffix=
# The AWS region to create resources
#region=
# The CIDR block for the VPC
#vpc_cidr=

# Keycloak Database Configuration
# The name of the Keycloak database
#keycloak_db_name=
# The username for the Keycloak database
#keycloak_db_username=
# The password for the Keycloak database
#keycloak_db_password=

# Keycloak Admin Configuration
# The username for the Keycloak admin user
#keycloak_admin_username=
# The password for the Keycloak admin user
#keycloak_admin_password=

# Hub Database Configuration
# The name of the Hub database
#hub_db_name=
# The username for the Hub database
#hub_db_username=
# The password for the Hub database
#hub_db_password=

# Katta Server admin user in the realm
# The username for the Katta Server admin user
#hub_admin_username=
# The initial password for the Katta Server admin user, to be changed on first login
#hub_admin_password=

# Version or version range of the Katta Server Helm chart to render the Keycloak realm from, null for the latest version
#katta_chart_version=

# Initial license token and matching Hub ID for Katta Server, defaults to the shared test license, null to start without a license
#hub_initial_license=
#hub_initial_id=
# Common name of the CA issuing the license certificate chain, defaults to the test CA matching the shared test license
#hub_license_chain_required_cn=

# Client secret for client "cryptomatorhub-system"
# hub_keycloak_system_client_secret=
# Client secret for client "cryptomatorvaults"
# hub_keycloak_oidc_cryptomator_vaults_client_secret=

# Additional connect-src sources for the Content-Security-Policy header, e.g. the S3 and STS
# endpoints of storage profiles outside AWS. AWS endpoints are covered by *.amazonaws.com.
#hub_csp_additional_connect_src=["https://*.wasabisys.com"]
